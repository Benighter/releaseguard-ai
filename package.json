{
  "name": "releaseguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first release readiness MCP server for the Amazon Build, Ship, Shape Hackathon.",
  "scripts": {
    "dev": "tsx src/http.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/http.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test",
    "smoke:mcp": "npm run build && node dist/tests/mcp-smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1123.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright-core": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
